# Copy this file to infra/aws/.env and customize for your account/environment.
# Then load it before running scripts:
#   set -a; source .env; set +a

# ===== Required =====
AWS_REGION=us-east-1
AMI_ID=ami-xxxxxxxxxxxxxxxxx
INSTANCE_TYPE=t3.medium
KEY_NAME=my-keypair
SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
HOSTED_ZONE_ID=Z1234567890ABC
RECORD_NAME=perceptrome.com

# ===== Optional =====
# IAM instance profile name for EC2. Leave empty only if your provisioning
# flow does not require attaching an instance profile.
IAM_INSTANCE_PROFILE=

# Linux username used when bootstrapping the EC2 host.
EC2_BOOTSTRAP_USER=

# Application checkout directory on the EC2 host.
APP_DIR=/opt/perceptrome

# Optional NCBI settings for workloads that call NCBI APIs.
NCBI_EMAIL=
NCBI_API_KEY=

# Toggle automatic TLS setup in your deployment tooling.
ENABLE_TLS=true

# Email used for Let's Encrypt registration when TLS is enabled.
LETSENCRYPT_EMAIL=
